# Backend: copy to root .env or apps/api/.env. Never commit credentials.
PORT=3001
HOST=0.0.0.0
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
CRAWL_TIMEOUT_MS=5000
CRAWL_MAX_CONCURRENCY=4

# Web: set API_BASE_URL in apps/web/.env.local, or in hosting environment before build.
API_BASE_URL=http://localhost:3001

# Optional helper only; active demo/research routes do not call an LLM.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
